<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部阴影 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#1AF8FAFC" />
        </shape>
    </item>
    <!-- 右下角阴影 -->
    <item android:left="4dp" android:top="4dp" android:right="2dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#33F8FAFC" />
        </shape>
    </item>
    <!-- 左上角高光 -->
    <item android:left="2dp" android:top="2dp" android:right="4dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#0D000000" />
        </shape>
    </item>
    <!-- 主体背景 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#CC000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
