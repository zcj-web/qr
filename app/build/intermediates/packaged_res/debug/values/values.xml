<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="iteration_options">
        <item>10,000 次 (快速)</item>
        <item>100,000 次 (推荐)</item>
        <item>500,000 次 (安全)</item>
    </string-array>
    <attr format="float" name="glassAlpha"/>
    <bool name="use_dark_mode">true</bool>
    <color name="day_glass_bg">#CCFFFFFF</color>
    <color name="day_glass_border">#33000000</color>
    <color name="day_glass_shadow">#1A000000</color>
    <color name="day_on_surface">#0F172A</color>
    <color name="day_on_surface_variant">#475569</color>
    <color name="day_primary">#6366F1</color>
    <color name="day_primary_variant">#4F46E5</color>
    <color name="day_surface">#FFFFFF</color>
    <color name="day_surface_variant">#F8FAFC</color>
    <color name="night_glass_bg">#CC000000</color>
    <color name="night_glass_border">#33FFFFFF</color>
    <color name="night_glass_shadow">#1AF8FAFC</color>
    <color name="night_on_surface">#F8FAFC</color>
    <color name="night_on_surface_variant">#94A3B8</color>
    <color name="night_primary">#818CF8</color>
    <color name="night_primary_variant">#6366F1</color>
    <color name="night_surface">#000000</color>
    <color name="night_surface_variant">#0F172A</color>
    <color name="qr_bg">#FFFFFF</color>
    <color name="qr_dot">#1E293B</color>
    <string name="app_name">二维码</string>
    <string name="pref_theme_mode" translatable="false">theme_mode</string>
    <style name="TabTextStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.QrCode" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/day_primary</item>
        <item name="colorPrimaryVariant">@color/day_primary_variant</item>
        <item name="colorOnPrimary">@color/day_on_surface</item>
        <item name="colorSurface">@color/day_surface</item>
        <item name="colorSurfaceVariant">@color/day_surface_variant</item>
        <item name="colorOnSurface">@color/day_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/day_on_surface_variant</item>
        <item name="android:windowBackground">@color/day_surface</item>
        <item name="android:statusBarColor">@color/day_surface</item>
        <item name="android:navigationBarColor">@color/day_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.QrCode.Night" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/night_primary</item>
        <item name="colorPrimaryVariant">@color/night_primary_variant</item>
        <item name="colorOnPrimary">@color/night_on_surface</item>
        <item name="colorSurface">@color/night_surface</item>
        <item name="colorSurfaceVariant">@color/night_surface_variant</item>
        <item name="colorOnSurface">@color/night_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/night_on_surface_variant</item>
        <item name="android:windowBackground">@color/night_surface</item>
        <item name="android:statusBarColor">@color/night_surface</item>
        <item name="android:navigationBarColor">@color/night_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="zxing_CaptureTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">#80000000</item>
    </style>
</resources>