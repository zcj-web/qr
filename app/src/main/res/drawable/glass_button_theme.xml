<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/glassCardShadow" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/glassCardShadowSecondary" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/glassCardHighlight" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="?attr/glassCardBackground" />
            <stroke android:width="1dp" android:color="?attr/glassCardStroke" />
        </shape>
    </item>
</layer-list>